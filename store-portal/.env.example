# ── 認証（本番では必ず設定）──
# AUTH_SECRET を設定すると本番モード（署名付きセッション＋資格情報チェック）になる。
# 未設定だと開発モード（任意のメール/パスワードで通過）。
AUTH_SECRET=
# 資格情報: どちらかを設定。パスワードは平文 or sha256(16進64桁)。
#   sha256 生成例: printf '%s' 'yourpassword' | shasum -a 256
AUTH_USERS=              # 例: "a@nexus.co.jp:5e884898...,b@nexus.co.jp:plainpass"
AUTH_EMAIL=              # 単一ユーザー運用の場合
AUTH_PASSWORD=

# ── データソース ──
# mock（既定・サーバー内メモリ） / file（JSON永続・自己ホスト/Docker） / http（外部API）
DATA_SOURCE=mock
# DATA_SOURCE=file のとき JSON を保存するディレクトリ（既定 .data）
DATA_DIR=
# DATA_SOURCE=http のとき /state・/mutate を提供する外部APIのベースURL
API_BASE=

# ── ビルド情報（任意・CI で埋め込み推奨）──
# NEXT_PUBLIC_COMMIT=$(git rev-parse --short HEAD)
# NEXT_PUBLIC_BUILT_AT=
